{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/mediawiki",
		"wikimedia/jquery"
	],
	"globals": {
		"mediaWiki": false,
		"jQuery": false,
		"ve": false
	},
	"rules": {
		"valid-jsdoc": "off",
		"no-redeclare": "off",
		"no-unused-vars": "warn",
		"no-shadow": "warn",
		"mediawiki/msg-doc": "warn",
		"no-jquery/no-class-state": "warn",
		"no-jquery/variable-pattern": "warn",
		"no-jquery/no-each-util": "warn",
		"no-jquery/no-animate-toggle": "warn",
		"no-jquery/no-global-selector": "warn",
		"no-jquery/no-sizzle": "warn",
		"no-jquery/no-done-fail": "warn",
		"prefer-const": "warn"
	},
	"overrides": [
		{
			"files": [
				"tests/node-qunit/**/*.js"
			],
			"env": {
				"node": true,
				"es2021": true
			},
			"globals": {
				"QUnit": "readonly"
			},
			"parserOptions": {
				"sourceType": "script"
			}
		},
		{
			"files": [
				"tests/browser/**/*.js"
			],
			"env": {
				"node": true,
				"browser": true,
				"es2021": true
			},
			"parserOptions": {
				"ecmaVersion": 2022
			},
			"rules": {
				"no-console": "off",
				"n/no-process-exit": "off",
				"es-x/no-async-functions": "off",
				"es-x/no-object-values": "off"
			}
		}
	]
}
